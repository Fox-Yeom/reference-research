#!/usr/bin/env python3
"""AI 커밋 메시지 검증기 (git commit-msg 훅). 규칙 설명은 docs/02-commit.md."""
import os
import re
import subprocess
import sys
import unicodedata

TYPES = ("feat", "fix", "docs", "style", "refactor", "test", "chore", "init")
WHY_REQUIRED = ("feat", "fix")
MAX_WIDTH = 72
MARKER = ".commit-convention"

HEADER = re.compile(rf"^({'|'.join(TYPES)})(\([a-z0-9_-]+\))?!?: (\S.*)$")
TASK_BRANCH = re.compile(rf"^({'|'.join(TYPES + ('hotfix',))})/([0-9]+)(-[a-z0-9]+)+$")
REFS = re.compile(r"^Refs: #([0-9]+)$")
# git이 만든 메시지는 그 작업이 진행 중일 때만 형식 검사를 건너뛴다. 직접 쓴 같은 접두어는 검사한다.
GENERATED = {"merge": re.compile(r"^Merge "), "revert": re.compile(r'^(Revert "|Reapply ")')}
# 에디터가 넣는 주석 줄(`# …`, `#\t…`, `#`)만 주석이다. `#18 로그인 수정`은 제목이다.
COMMENT = re.compile(r"^#(\s|$)")
SCISSORS = "# ------------------------ >8 ------------------------"
# 도입 저장소에서 Agent가 직접 커밋하지 않는 통합·배포 브랜치(docs/01-work-and-branch.md).
PROTECTED_BRANCH = re.compile(r"^(main|master|develop|dev|development|production|staging|release/.+)$")
SENTENCE_ENDING = re.compile(r"(니다|했음|됐음|했다|됐다|한다|된다|(?<!포)함|됨)$")
AI_ATTRIBUTION = re.compile(
    r"co-authored-by:.*(claude|anthropic)|generated with.*claude|^claude-session:",
    re.IGNORECASE | re.MULTILINE,
)

GUIDE = f"""
형식:
  <type>(<scope>): <한글 요약>

  왜: <변경 이유>

  Refs: #123

type: {' '.join(TYPES)}  (feat·fix는 `왜:` 필수)
요약: 명사형으로 끝낸다(추가, 수정, 해결). 마침표 금지.
폭: 모든 줄 {MAX_WIDTH}칸 이내(한글 2칸, 영문 1칸).
참조: {MARKER}가 커밋된 저장소의 <type>/<번호>-<slug> 브랜치는 `Refs: #<번호>` 필수.

메시지를 고쳐 다시 커밋한다. --no-verify로 우회하지 않는다."""


def display_width(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def current_branch():
    """현재 브랜치 이름. rebase와 detached HEAD에서는 빈 문자열이다."""
    result = subprocess.run(
        ["git", "branch", "--show-current"],
        capture_output=True,
        encoding="utf-8",
        errors="replace",
    )
    return result.stdout.strip()


def scissors_index(lines):
    """`>8` 선이 있는 줄 번호. 없으면 None.

    git commit -v의 diff는 메시지가 아니다. git은 이 선 다음에 주석 줄을 붙이므로 다음 줄이 주석일 때만 선으로 본다.
    """
    for index, line in enumerate(lines[:-1]):
        if line == SCISSORS and lines[index + 1].startswith("#"):
            return index
    return None


def check(message, branch="", in_progress=()):
    """위반 내용 목록을 돌려준다. 빈 목록이면 통과.

    in_progress: 진행 중인 git 작업("merge", "revert"). 그 작업이 만든 메시지는 형식 검사를 건너뛴다.
    merge는 `Refs`도 건너뛰고, revert는 Task 브랜치의 `Refs`를 검사한다(05 Rework 변경 분리).
    `>8` 선 아래는 형식을 검사하지 않는다. 커밋에 남을 수 있으므로 AI 작성 표기는 찾는다.
    편집기를 쓴 커밋은 main()이 선 아래를 먼저 잘라 낸다.
    """
    message = unicodedata.normalize("NFC", message)  # macOS NFD 한글 대응
    raw, below = message.splitlines(), []
    cut = scissors_index(raw)
    if cut is not None:
        raw, below = raw[:cut], raw[cut:]
    lines = [line.rstrip() for line in raw if not COMMENT.match(line)]
    while lines and not lines[-1]:
        lines.pop()
    while lines and not lines[0]:
        lines.pop(0)
    if not lines:
        return ["메시지가 비어 있음 (`# `로 시작하는 줄은 주석으로 빠짐)"]
    # `-m`과 `-F`는 주석을 지우지 않으므로 주석 모양 줄도 커밋에 남는다. 표기는 원문 전체에서 찾는다.
    extra = []
    if COMMENT.match(next(line for line in raw if line.strip())):
        extra.append("제목 앞에 `#` 줄이 있음 (`-m`으로 쓰면 그 줄이 그대로 제목이 됨)")
    if AI_ATTRIBUTION.search("\n".join(raw + below)):
        extra.append("AI 작성 표기 금지 (Co-Authored-By: Claude 등)")
    generated = {name for name in in_progress if name in GENERATED and GENERATED[name].match(lines[0])}
    if "merge" in generated:
        return extra
    refs = refs_errors(lines[2:], branch)
    if generated:
        return refs + extra

    errors = []
    header, body = lines[0], lines[2:]
    match = HEADER.match(header)

    if match:
        commit_type, _, subject = match.groups()
        if not re.search(r"[가-힣]", subject):
            errors.append("요약에 한글이 없음")
        if subject.endswith("."):
            errors.append("요약 끝에 마침표 사용")
        if SENTENCE_ENDING.search(subject):
            errors.append("요약이 서술형으로 끝남 (명사형으로: 추가, 수정, 해결)")
        if commit_type in WHY_REQUIRED and not any(
            line.startswith("왜: ") for line in body
        ):
            errors.append(f"{commit_type}에 `왜: <이유>` 줄 없음")
    else:
        errors.append(f"제목 형식 불일치: {header!r}")

    if display_width(header) > MAX_WIDTH:
        errors.append(f"제목 폭 {display_width(header)}칸 ({MAX_WIDTH}칸 초과)")
    if len(lines) > 1 and lines[1]:
        errors.append("제목 다음 줄은 비워야 함")
    for line in body:
        if display_width(line) > MAX_WIDTH and "://" not in line:
            errors.append(f"본문 줄 폭 {MAX_WIDTH}칸 초과: {line[:30]}...")
    return errors + refs + extra


def refs_errors(body, branch):
    task_branch = TASK_BRANCH.match(branch)
    if not task_branch:
        return []
    number = task_branch.group(2)
    if number in [m.group(1) for m in map(REFS.match, body) if m]:
        return []
    return [f"`Refs: #{number}` 줄 없음 (브랜치 {branch})"]


def check_branch(branch):
    """도입 저장소의 통합·배포 브랜치 직접 커밋을 막는다. 첫 `init:` 커밋은 HEAD가 없어 도입 판정 전이다."""
    if PROTECTED_BRANCH.match(branch):
        return [f"통합·배포 브랜치 직접 커밋 금지 ({branch}). Task 브랜치 <type>/<번호>-<slug>에서 커밋한다"]
    return []


def in_progress():
    """진행 중인 merge, revert. 작업 트리마다 다른 상태 파일을 git에게 묻는다."""
    found = []
    for name, head in (("merge", "MERGE_HEAD"), ("revert", "REVERT_HEAD")):
        path = subprocess.run(
            ["git", "rev-parse", "--git-path", head], capture_output=True, text=True
        ).stdout.strip()
        if path and os.path.exists(path):
            found.append(name)
    return found


def is_adopted():
    """전역 훅이 컨벤션을 쓰지 않는 저장소를 막지 않게 표식으로 판정한다.

    로컬 설정은 clone에 복사되지 않으므로 커밋된 파일을 본다. index가 아니라
    HEAD를 봐야 표식을 지우는 커밋도 검사하고 커밋 전 표식은 인정하지 않는다.
    """
    result = subprocess.run(
        ["git", "cat-file", "-t", f"HEAD:{MARKER}"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() == "blob"


def is_enforced():
    """AI 커밋만 검사한다. 저장소별 해제: git config commitlint.skip true"""
    if not (os.environ.get("CLAUDECODE") or os.environ.get("COMMIT_LINT_STRICT")):
        return False
    skip = subprocess.run(
        ["git", "config", "--type=bool", "--get", "commitlint.skip"],
        capture_output=True,
        text=True,
    )
    return skip.stdout.strip() != "true"


def above_scissors(message):
    """`>8` 선 위의 메시지. 선이 없으면 None. git이 `-v`에서 잘라 내는 자리와 같다."""
    cut = scissors_index(message.splitlines())
    return None if cut is None else "".join(message.splitlines(keepends=True)[:cut])


def main():
    if not is_enforced():
        return 0
    sys.stderr.reconfigure(encoding="utf-8", errors="backslashreplace")
    # UTF-8이 아닌 바이트도 다시 쓸 때 그대로 돌아가게 읽는다.
    with open(sys.argv[1], "rb") as message_file:
        message = message_file.read().decode("utf-8", errors="surrogateescape")
    # git은 편집기를 띄우지 않는 커밋(-m, -F, -C, --no-edit)의 훅에 GIT_EDITOR=: 를 준다.
    # 편집기를 쓴 커밋의 `>8` 선 아래는 git이 붙인 diff일 수 있다. 검사하지 않고 메시지 파일에서 지운다.
    # `-v` 없이 선을 직접 넣으면 git이 그 아래를 커밋에 남기므로, 지워야 검사하지 않은 줄이 남지 않는다.
    kept = above_scissors(message) if os.environ.get("GIT_EDITOR") != ":" else None
    branch = current_branch() if is_adopted() else ""
    errors = check_branch(branch) + check(message if kept is None else kept, branch, in_progress())
    if not errors:
        if kept is not None:
            with open(sys.argv[1], "wb") as message_file:
                message_file.write(kept.encode("utf-8", errors="surrogateescape"))
        return 0
    print("[commit-msg] 커밋 거부:", file=sys.stderr)
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    print(GUIDE, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
